# Copy to local.env (gitignored) and fill in. Never commit the real values.
# Where to find them: the NAS owner's notes, or the media-server project.

# user@host that the check-prod skill SSHes to
NAS_SSH=user@nas-host
# Directory on the NAS holding driver.status, driver.log, manifest.jsonl and the import queue
NAS_STAGE_DIR=/path/to/neutraliser-stage
# Directory the manifest's relative paths hang off
NAS_MEDIA_ROOT=/path/to/media
# Log written on the Mac by the hourly sweep kick
SWEEP_LOG=$HOME/Library/Logs/sweep.log
