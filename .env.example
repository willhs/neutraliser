# Plex Server Configuration
# Copy this file to .env and fill in your values

# Your Plex authentication token
# Get it from: http://localhost:32400/web/index.html#!/settings/account
PLEX_TOKEN=your_plex_token_here

# Plex server URL (optional - defaults to localhost:32400)
# Examples:
# PLEX_SERVER_URL=http://192.168.1.100:32400  # Local server
# PLEX_SERVER_URL=https://app.plex.tv         # Plex.tv (remote access)
# PLEX_SERVER_URL=http://localhost:32400      # Default local
PLEX_SERVER_URL=http://localhost:32400

# Note: Audio analysis uses Plex streaming - no local file access needed